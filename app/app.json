{
  "expo": {
    "name": "BananaVision",
    "slug": "app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E3F3E9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "BananaVision uses your camera to photograph bananas and check how ripe they are.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BananaVision lets you choose a banana photo from your library to check how ripe it is."
        }
      ],
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F6F2",
          "image": "./assets/splash-icon.png",
          "imageWidth": 132,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0A1413",
            "image": "./assets/splash-icon-dark.png"
          }
        }
      ]
    ]
  }
}
